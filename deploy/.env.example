# Public domain name, or the Pi's LAN IP (e.g. 192.168.1.50).
# NOTE: this becomes the Matrix server name and can't be changed later without losing chat history.
DOMAIN=werk.example.com

# generate each with: openssl rand -hex 32
JWT_SECRET=
MATRIX_PASSWORD_SECRET=
MATRIX_REGISTRATION_TOKEN=
LIVEKIT_SECRET=
TURN_SECRET=

ALLOW_GUESTS=true
ALLOW_SIGNUP=false
START_MAP=/maps/hq/floor-4.tmj
# WERK_IMAGE=ghcr.io/you/werkadventure:latest
